{
  "name": "cf-tunnel-panel",
  "version": "0.29.64",
  "description": "可视化 Docker 面板：用 cloudflared 隧道 + Caddy 本地反代，把内网服务发布到公网",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianghugs/cf-tunnel-panel.git"
  },
  "homepage": "https://github.com/jianghugs/cf-tunnel-panel#readme",
  "bugs": {
    "url": "https://github.com/jianghugs/cf-tunnel-panel/issues"
  },
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run check && npm run test:api && npm run test:dom",
    "test:requires": "node tools/check-requires.js",
    "test:i18n": "node tools/i18n-check.js",
    "test:api": "node test/api.test.mjs",
    "test:dom": "node test/dom.test.cjs",
    "test:openapi": "node tools/openapi.js --check",
    "test:alerts": "node tools/check-alerts.js",
    "test:smoke": "node test/smoke.mjs",
    "lint": "eslint .",
    "test:lint": "eslint . --quiet",
    "check": "npm run test:requires && npm run test:i18n && npm run test:openapi && npm run test:alerts && npm run test:lint",
    "e2e:local": "bash tools/local-e2e.sh",
    "verify": "npm run check && npm run test:smoke && npm run e2e:local"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jsdom": "^31.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}

    {
      "type": "timeseries",
      "title": "Caddy 下发失败与未处理拒绝",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 112
      },
      "description": "最近 10 分钟增量：Caddy 下发失败次数、未处理的 Promise 拒绝次数（两者都应为 0）",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "expr": "increase(cf_caddy_push_failures_total[10m])",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "expr": "increase(cf_unhandled_rejections_total[10m])",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },

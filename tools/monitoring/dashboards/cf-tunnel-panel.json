          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cf_exit_requests_5m",
          "legendFormat": "{{name}} 请求"
        },
        {
          "refId": "B",
          "expr": "cf_exit_errors_5m",
          "legendFormat": "{{name}} 错误"
        }
      ]
    },
    {
      "type": "stat",
      "title": "体检失败项",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-main"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 108
      },
      "description": "最近一次一键体检的失败项数，>0 说明有真问题（对应告警 SelfcheckFailing）",

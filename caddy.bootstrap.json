{
  "admin": {
    "listen": "127.0.0.1:20190"
  },
  "apps": {
    "http": {
      "servers": {
        "main": {
          "listen": [
            "127.0.0.1:8080"
          ],
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 503,
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ],
                    "Retry-After": [
                      "5"
                    ]
                  },
                  "body": "cf-tunnel-panel: 面板还没接管 Caddy（正在启动或没有主实例）\n请稍后重试；持续这样就看 docker logs cf-tunnel-panel\n"
                }
              ]
            }
          ]
        }
      }
    }
  }
}